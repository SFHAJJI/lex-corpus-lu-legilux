# Publisher evidence is byte-addressed by SHA-256 in version metadata. Git must
# never rewrite line endings in legal bodies or structural manifestations.
works/** -text -diff

# Generated metadata is canonical JSON rather than publisher-verbatim evidence.
# Keep its repository representation reviewable and platform-independent.
works/**/meta.json text eol=lf

README.md text eol=lf
NOTICE text eol=lf
manifest.json text eol=lf
