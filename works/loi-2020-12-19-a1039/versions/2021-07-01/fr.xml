t/leg/loi/2020/12/19/a1039/consolide/20210701/fr/pdf</scl:jolux><scl:jolux scl:name="embodies">http://data.legilux.public.lu/eli/etat/leg/loi/2020/12/19/a1039/consolide/20210701/fr</scl:jolux><scl:jolux scl:name="publisher">http://data.legilux.public.lu/authority/legal-institution/ME</scl:jolux><scl:jolux scl:lg="fra" scl:name="rights">Copyright : Ministère d’État du Grand-Duché de Luxembourg – Service central de législation</scl:jolux><scl:jolux scl:name="rightsHolder">http://data.legilux.public.lu/authority/legal-institution/ME</scl:jolux><scl:jolux scl:name="license">http://creativecommons.org/licenses/by/4.0/</scl:jolux><scl:jolux scl:name="userFormat">http://data.legilux.public.lu/resource/authority/user-format/pdf</scl:jolux><scl:jolux scl:name="format">http://publications.europa.eu/resource/authority/file-type/PDF</scl:jolux><scl:jolux scl:name="isExemplifiedBy">http://data.legilux.public.lu/file/eli-etat-leg-loi-2020-12-19-a1039-consolide-20210701-fr-pdf.pdf</scl:jolux></scl:JOLUXManifestation></identification><lifecycle source="#"><eventRef date="2020-12-19" id="e1" originatingExpression="true" source="#ro1" type="generation"/><eventRef date="2021-07-01" id="e2" originatingExpression="true" source="#rp2" type="amendment"/></lifecycle><analysis source="#"><passiveModifications><textualMod id="pm1" incomplete="false" type="replacement"><source href="/eli/etat/leg/loi/2021/06/30/a486/jo"/><destination href="#art_4"/></textualMod></passiveModifications></analysis><references source="#"><original href="/eli/etat/leg/loi/2020/12/19/a1039/jo" id="ro1" showAs="Original"/><passiveRef href="/eli/etat/leg/loi/2021/06/30/a486/jo" id="rp2" showAs="Loi du 30 juin 2021 portant modification de la loi du 19 décembre 2020 portant dérogation temporaire à l’article L. 121-6 du Code du travail."/></references><notes scl:type="modification" source="#rp2"><note id="M1" marker="1" refersTo="pm1" title="A|2021-06-30|2021-06-30|L|486"><content><p><ref href="http://data.legilux.public.lu/eli/etat/leg/loi/2021/06/30/a486/jo">Loi du 30 juin 2021 portant modification de la loi du 19 décembre 2020 portant dérogation temporaire à l’article L. 121-6 du Code du travail.</ref></p></content></note></notes></meta><preface><longTitle style="11"><p>Version consolidée applicable au 01/07/2021 : Loi du 19 décembre 2020 portant dérogation temporaire à l’article L. 121-6 du Code du travail.</p></longTitle></preface><body><article id="art_1er"><scl:JOLUXWork><scl:JOLUXComplexWork><scl:jolux scl:name="uriThis">http://data.legilux.public.lu/eli/etat/leg/loi/2020/12/19/a1039/art_1er</scl:jolux></scl:JOLUXComplexWork><scl:JOLUXLegalResource><scl:jolux scl:name="uriThis">http://data.legilux.public.lu/eli/etat/leg/loi/2020/12/19/a1039/art_1er/20201221</scl:jolux><scl:jolux scl:name="isMemberOf">http://data.legilux.public.lu/eli/etat/leg/loi/2020/12/19/a1039</scl:jolux><scl:jolux scl:lg="fra" scl:name="title">Art. 1er.</scl:jolux><scl:jolux scl:name="dateApplicability">2020-12-21</scl:jolux><scl:rdf scl:name="type">http://data.legilux.public.lu/resource/ontology/jolux#Article</scl:rdf></scl:JOLUXLegalResource></scl:JOLUXWork><num>Art. 1<sup>er</sup>.</num><alinea><content><p>Par dérogation à l’article L. 121-6, paragraphe 1<sup>er</sup>, du <ref href="/eli/etat/leg/code/travail" id="2632cf31-2690-420a-a703-517797d911dc">Code du travail</ref>, le salarié incapable de travailler pour cause de mise en quarantaine ou en isolement est obligé, le jour même de l’empêchement, d’en avertir personnellement ou par personne interposée l’employeur ou le représentant de celui-ci. </p></content></alinea></article><article id="art_2"><scl:JOLUXWork><scl:JOLUXComplexWork><scl:jolux scl:name="uriThis">http://data.legilux.public.lu/eli/etat/leg/loi/2020/12/19/a1039/art_2</scl:jolux></scl:JOLUXComplexWork><scl:JOLUXLegalResource><scl:jolux scl:name="uriThis">http://data.legilux.public.lu/eli/etat/leg/loi/2020/12/19/a1039/art_2/20201221</scl:jolux><scl:jolux scl:name="isMemberOf">http://data.legilux.public.lu/eli/etat/leg/loi/2020/12/19/a1039</scl:jolux><scl:jolux scl:lg="fra" scl:name="title">Art. 2.</scl:jolux><scl:jolux scl:name="dateApplicability">2020-12-21</scl:jolux><scl:rdf scl:name="type">http://data.legilux.public.lu/resource/ontology/jolux#Article</scl:rdf></scl:JOLUXLegalResource></scl:JOLUXWork><num>Art. 2.</num><alinea><content><p>Par dérogation à l’article L. 121-6, paragraphe 2, du même <ref href="/eli/etat/leg/code/travail" id="e4aba4b7-4a7e-4d9f-afd5-1dbd6d9435c6">code</ref>, le salarié incapable de travailler pour cause de mise en quarantaine ou en isolement est obligé de soumettre à l’employeur, au plus tard le huitième jour de son absence, une ordonnance officielle de mise en quarantaine ou de mise en isolement émanant de l’autorité nationale compétente et servant de certificat d’incapacité de travail.</p></content></alinea></article><article id="art_3"><scl:JOLUXWork><scl:JOLUXComplexWork><scl:jolux scl:name="uriThis">http://data.legilux.public.lu/eli/etat/leg/loi/2020/12/19/a1039/art_3</scl:jolux></scl:JOLUXComplexWork><scl:JOLUXLegalResource><scl:jolux scl:name="uriThis">http://data.legilux.public.lu/eli/etat/leg/loi/2020/12/19/a1039/art_3/20201221</scl:jolux><scl:jolux scl:name="isMemberOf">http://data.legilux.public.lu/eli/etat/leg/loi/2020/12/19/a1039</scl:jolux><scl:jolux scl:lg="fra" scl:name="title">Art. 3.</scl:jolux><scl:jolux scl:name="dateApplicability">2020-12-21</scl:jolux><scl:rdf scl:name="type">http://data.legilux.public.lu/resource/ontology/jolux#Article</scl:rdf></scl:JOLUXLegalResource></scl:JOLUXWork><num>Art. 3.</num><alinea><content><p>Par dérogation à l’article L. 121-6, paragraphe 3, alinéa 1<sup>er</sup>, du même <ref href="/eli/etat/leg/code/travail" id="26d65011-39b5-4f64-a6d5-675085ce1e59">code</ref>, l’employeur averti conformément à l’article <span scl:no-break="true">L. 121-6</span>, paragraphe 1<sup>er</sup>, du <ref href="/eli/etat/leg/code/travail" id="df7900f6-c0a8-4fd6-b1f9-75efc78665fa">Code du travail</ref>, en possession du certificat médical visé à l’article <span scl:no-break="true">L. 121-6</span>, paragraphe 2, du <ref href="/eli/etat/leg/code/travail" id="64a054fb-4c12-40ed-9101-98b3475d620a">Code du travail</ref> ou en possession d’une ordonnance officielle de mise en quarantaine ou de mise en isolement visée à l’article 2 n’est pas autorisé, même pour motif grave, à notifier au salarié la résiliation de son contrat de travail, ou, le cas échéant, la convocation à l’entretien préalable visé à l’article L. 124-2 du <ref href="/eli/etat/leg/code/travail" id="25f8533a-77ae-44cd-97a0-6b3c4cecd835">Code du travail</ref> pour une période de vingt-six semaines au plus à partir du jour de la survenance de l’incapacité de travail.</p></content></alinea></article><article id="art_4"><scl:JOLUXWork><scl:JOLUXComplexWork><scl:jolux scl:name="uriThis">http://data.legilux.public.lu/eli/etat/leg/loi/2020/12/19/a1039/art_4</scl:jolux></scl:JOLUXComplexWork><scl:JOLUXLegalResource><scl:jolux scl:name="uriThis">http://data.legilux.public.lu/eli/etat/leg/loi/2020/12/19/a1039/art_4/20210701</scl:jolux><scl:jolux scl:name="isMemberOf">http://data.legilux.public.lu/eli/etat/leg/loi/2020/12/19/a1039</scl:jolux><scl:jolux scl:lg="fra" scl:name="title">Art. 4.</scl:jolux><scl:jolux scl:name="dateApplicability">2021-07-01</scl:jolux><scl:rdf scl:name="type">http://data.legilux.public.lu/resource/ontology/jolux#Article</scl:rdf></scl:JOLUXLegalResource></scl:JOLUXWork><num>Art. 4.</num><alinea><content><p>La présente loi entre en vigueur le jour de sa publication au Journal officiel du Grand-Duché de Luxembourg et reste applicable jusqu’au <mod class="mod-start" for="#pm1"/>31 décembre<mod class="mod-end" for="#pm1"/><noteRef href="#M1" marker="1"/> 2021 inclus.</p></content></alinea></article></body></act></akomaNtoso>