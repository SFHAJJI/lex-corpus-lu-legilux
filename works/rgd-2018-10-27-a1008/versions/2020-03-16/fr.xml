						</scl:JOLUXLegalResource>
					</scl:JOLUXWork>
					<num>Art. 9.</num>
					<alinea>
						<content>
							<p>Le présent règlement grand-ducal entre en vigueur le 1<sup>er</sup> janvier 2019.</p>
						</content>
					</alinea>
				</article>
				<article id="art_10">
					<scl:JOLUXWork>
						<scl:JOLUXComplexWork>
							<scl:jolux scl:name="uriThis">http://data.legilux.public.lu/eli/etat/leg/rgd/2018/10/27/a1008/art_10</scl:jolux>
